# ========================================
# ELNESR — Environment Variables
# Copy to .env and fill in real values
# ========================================

# PostgreSQL — connects to DO Postgres, schema=elnesr
DATABASE_URL=postgresql://elnesr:Elnesr2026!Secure@localhost:5432/elnesr_db

# JWT secret (CHANGE in production!)
JWT_SECRET=change-this-to-a-random-32-char-string-2026

# Public site URL
NEXT_PUBLIC_SITE_URL=https://elnesr.openappo.com

# App name
NEXT_PUBLIC_APP_NAME=شركة النسر للأدوات واللوحات الكهربائية
